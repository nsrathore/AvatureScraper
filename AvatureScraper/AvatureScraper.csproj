<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>AvatureScraper</RootNamespace>
    <AssemblyName>AvatureScraper</AssemblyName>
    <Description>Async Avature ATS scraper — discovers and extracts job listings from all Avature-powered career pages</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- HTML parsing (far better than regex on malformed HTML) -->
    <PackageReference Include="AngleSharp" Version="1.1.2" />
    <!-- Polly for retry/backoff policies on HttpClient -->
    <PackageReference Include="Polly" Version="8.3.1" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="8.0.4" />
    <!-- DI + logging (production-grade) -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
    <!-- CSV output -->
    <PackageReference Include="CsvHelper" Version="33.0.1" />
  </ItemGroup>

</Project>
